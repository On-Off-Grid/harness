{
  "defaultProvider": "kimi-coding",
  "defaultModel": "kimi-for-coding",
  "theme": "dark",
  "defaultThinkingLevel": "xhigh",
  "thinkingBudgets": {
    "low": 8192,
    "medium": 16384,
    "high": 32768,
    "xhigh": 60000
  },
  "skills": [
    "~/.kiro/skills"
  ],
  "enableSkillCommands": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "provider": {
      "maxRetries": 0
    }
  },
  "branchSummary": {
    "skipPrompt": true
  },
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000
  },
  "lastChangelogVersion": "0.79.6",
  "terminal": {
    "showTerminalProgress": false
  },
  "quietStartup": false,
  "packages": [
    "npm:pi-casefile@1.3.8",
    "npm:pi-recon-tools@1.0.2",
    "npm:@artale/pi-pentest@1.0.0",
    "npm:pi-redteam@1.0.5",
    "npm:@vigolium/piolium@0.0.11",
    "npm:pi-web-access@0.13.0"
  ]
}